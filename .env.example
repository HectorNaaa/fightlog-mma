# PostgreSQL connection (Neon / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT secret — generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-strong-secret-at-least-32-characters"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Web Push (browser + mobile PWA notifications) — generate with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:support@fightlogapp.vercel.app"
